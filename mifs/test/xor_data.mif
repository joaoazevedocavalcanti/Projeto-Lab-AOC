DEPTH = 256;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT
BEGIN

000 : FF00FF00;  -- A
001 : 0FF00FF0;  -- B
002 : FFFFFFFF;  -- todos os bits em 1
006 : 00000400;  -- base MMIO (para escrever no LEDR)

[003..005] : 00000000;
[007..0FF] : 00000000;

080 : 00000410;
081 : 00000200;
082 : 00000004;
083 : 00000400;
084 : 000001FF;
085 : 000001E0;
086 : 00000200;

END;
